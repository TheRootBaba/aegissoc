APP_NAME=AegisSOC API
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_PASSWORD=aegis_dev_password
RUNTIME_DB_USER=aegis_runtime
# Replace with a unique random value (at least 32 characters) before production use.
RUNTIME_DB_PASSWORD=aegis_runtime_dev_password
# DATABASE_URL is set by Compose to the least-privilege runtime role.
# Replace with a unique random value (at least 32 characters) before production use.
AUTH_SECRET_KEY=dev-only-change-this-aegissoc-secret-key
ACCESS_TOKEN_MINUTES=30

WORKER_POLL_SECONDS=5
# Add connector secrets as environment variables referenced by env://NAME.

# Optional OpenID Connect SSO. Provision each subject with an administrator before first login.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET accepts env://VARIABLE_NAME or file:///run/secrets/oidc-client-secret
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid profile email
